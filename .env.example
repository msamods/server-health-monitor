# ==========================================
# VPS Health & Monitor Bot Configuration
# ==========================================

# 1. Telegram Bot Token from @BotFather
# Message @BotFather on Telegram, send /newbot, follow the prompts, and paste the token here.
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# 2. Authorized Admin Telegram User IDs (Comma-separated)
# Message @userinfobot or @raw_data_bot on Telegram to find your numerical User ID.
# Anyone NOT in this list will be strictly denied access.
ADMIN_CHAT_IDS=123456789,987654321

# 3. Server Nickname (Displayed in alert headers)
SERVER_NAME=My-Ubuntu-VPS

# 4. Monitoring Interval in seconds (Default: 60 seconds)
CHECK_INTERVAL=60

# 5. Alert Trigger Thresholds
CPU_THRESHOLD=90.0
RAM_THRESHOLD=85.0
DISK_THRESHOLD=90.0

# 6. Minimum cooldown between identical alerts in seconds (Default: 1800s = 30 minutes)
ALERT_COOLDOWN=1800

# 7. Enable Docker container monitoring (true/false)
ENABLE_DOCKER=true
